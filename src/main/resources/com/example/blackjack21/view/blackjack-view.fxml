<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.blackjack21.controller.BlackjackController">
    <padding>
        <Insets bottom="14.0" left="18.0" right="18.0" top="14.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <Label text="Blackjack 21" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
        <Label fx:id="saldoLabel" HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT"/>
    </HBox>

    <HBox alignment="CENTER" spacing="18.0">
        <Label fx:id="cartasRestantesLabel"/>
        <Label fx:id="apuestaVigenteLabel"/>
    </HBox>

    <!-- Mano y puntaje del computador. -->
    <VBox spacing="5.0">
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Label text="Computador" style="-fx-font-size: 16px; -fx-font-weight: bold;"
                   HBox.hgrow="ALWAYS"/>
            <Label fx:id="puntajeComputadorLabel"/>
        </HBox>
        <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER"
                    prefViewportHeight="150.0" minViewportHeight="150.0">
            <content>
                <HBox fx:id="manoComputadorCartasBox" alignment="CENTER_LEFT" spacing="8.0"/>
            </content>
        </ScrollPane>
    </VBox>

    <!-- Mano y puntaje del jugador. -->
    <VBox spacing="5.0">
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Label text="Jugador" style="-fx-font-size: 16px; -fx-font-weight: bold;"
                   HBox.hgrow="ALWAYS"/>
            <Label fx:id="puntajeLabel"/>
        </HBox>
        <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER"
                    prefViewportHeight="150.0" minViewportHeight="150.0">
            <content>
                <HBox fx:id="manoCartasBox" alignment="CENTER_LEFT" spacing="8.0"/>
            </content>
        </ScrollPane>
    </VBox>

    <Label fx:id="estadoLabel" maxWidth="Infinity" wrapText="true"/>

    <HBox alignment="CENTER" spacing="8.0">
        <!-- Recibe la apuesta antes de iniciar la ronda. -->
        <TextField fx:id="apuestaTextField" promptText="Apuesta" prefColumnCount="8"
                   HBox.hgrow="ALWAYS"/>
        <!-- Valida la apuesta y reparte la mano inicial. -->
        <Button fx:id="iniciarRondaButton" text="Iniciar ronda" onAction="#onIniciarRonda"/>
    </HBox>

    <HBox alignment="CENTER" spacing="8.0">
        <!-- Solicita otra carta para el jugador. -->
        <Button fx:id="pedirCartaButton" text="Pedir carta" onAction="#onPedirCarta"/>
        <!-- Termina el turno del jugador. -->
        <Button fx:id="plantarseButton" text="Plantarse" onAction="#onPlantarse"/>
        <!-- Abre el resumen de las reglas. -->
        <Button fx:id="verReglasButton" text="Ver reglas" onAction="#onVerReglas"/>
        <!-- Pide confirmación antes de cerrar el juego. -->
        <Button fx:id="cerrarJuegoButton" text="Cerrar juego" onAction="#onCerrarJuego"/>
    </HBox>
</VBox>
